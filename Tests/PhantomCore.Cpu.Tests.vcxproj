  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <OutDir>$(BaseOutputPath)CpuTests\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(BaseIntermediateOutputPath)$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>PhantomCore.Cpu.Tests</TargetName>
    <CpuPublicHeader>$(IntDir)PublicSdk\PhantomCore.h</CpuPublicHeader>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(IntDir)PublicSdk;$(ProjectDir)..\Engine\Core;$(ProjectDir)..\Engine\Collision;$(ProjectDir)..\Engine\Geometry;$(ProjectDir)..\Engine\Platform.Win32;$(ProjectDir)..\Engine\Graphics.D3D12;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>PHANTOMCORE_NO_AUTOLINK;WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="CpuTestsMain.cpp" />
    <ClCompile Include="Collision\CollisionTests.cpp" />
    <ClCompile Include="Collision\Visual2DUpdateTests.cpp" />
