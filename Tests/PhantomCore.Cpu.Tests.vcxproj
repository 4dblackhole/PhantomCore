  <!-- Compile the same CPU implementations; no SDK project, backend, or FMOD runtime. -->
  <Import Project="..\Engine\SDK\PublicHeaders.props" />
  <Target Name="GenerateCpuPublicHeader" BeforeTargets="ClCompile" Inputs="$(ProjectDir)..\Engine\SDK\GenerateCoreHeader.ps1;$(ProjectDir)..\Engine\SDK\PublicHeaders.props;@(CorePublicHeader->'$(ProjectDir)..\%(Identity)')" Outputs="$(IntDir)GenerateCoreHeader.stamp;$(CpuPublicHeader)">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\Engine\SDK\GenerateCoreHeader.ps1&quot; -RepositoryRoot &quot;$(ProjectDir)..&quot; -OutputPath &quot;$(CpuPublicHeader)&quot;" />
    <Touch Files="$(IntDir)GenerateCoreHeader.stamp" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(IntDir)GenerateCoreHeader.stamp;$(CpuPublicHeader)" />
    </ItemGroup>
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
